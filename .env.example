# fail-but-pretty Environment Variables
# Copy this file to .env and fill in your values

# Secret key for session middleware (required for Go Back functionality)
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# Optional: Custom domain for Caddy (configured in easy-deploy)
# SITE=fail-but-pretty.example.com